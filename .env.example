# Bu dosyayı .env adıyla kopyalayıp doldurun. .env GitHub'a yüklenmez.

# MongoDB Atlas bağlantı adresi
MONGODB_URI=mongodb+srv://kullanici:sifre@cluster0.xxxxx.mongodb.net/all-in-one

# Discord Developer Portal → Bot → Token
MODERASYON_TOKEN=

# Tüm komutları kullanabilecek geliştirici ID'leri (virgülle ayrılmış, boş bırakılabilir)
DEVELOPER_IDS=

# İsteğe bağlı: info, debug, warn, error
LOG_LEVEL=info
