{
  "name": "all-in-one",
  "version": "0.1.0",
  "private": true,
  "description": "discord.js v14 Discord bot altyapıları",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "imports": {
    "#core/*": {
      "development": "./src/core/*",
      "default": "./dist/core/*"
    },
    "#models/*": {
      "development": "./src/models/*",
      "default": "./dist/models/*"
    },
    "#services/*": {
      "development": "./src/services/*",
      "default": "./dist/services/*"
    },
    "#utils/*": {
      "development": "./src/utils/*",
      "default": "./dist/utils/*"
    }
  },
  "scripts": {
    "dev:moderasyon": "tsx watch --conditions=development --env-file=.env src/bots/moderasyon/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop ecosystem.config.cjs",
    "test": "vitest run",
    "check": "tsc --noEmit && biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "mongoose": "^9.10.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "mongodb-memory-server": "^11.3.0",
    "pm2": "^7.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
